# Environment Variables for FinCopilot

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI (Required for Production Persistence)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/fincopilot?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Frontend API Base URL (if separate domain in production)
VITE_API_BASE_URL=/api
