# Optional overrides for the Supabase project the app uses (see frontend/src/config.js).
# The defaults already point at the FinCopilot Supabase project; set these only to use another one.
# The publishable key is safe to be public: row-level security decides what each user can reach.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
